# ---- Pflicht (Betreiber) ----------------------------------------------------
# Zufallsstrings, je 32+ Zeichen (z. B. `openssl rand -hex 32`)
SESSION_SECRET=
TOKEN_ENC_KEY=
CRON_SECRET=
# Öffentliche URL ohne Slash am Ende. Optional: fehlt sie, wird sie aus der Anfrage abgeleitet (auf Vercel passt das).
# PUBLIC_URL=https://einnahmen.example
# Standard-Basiswährung neuer Konten (jeder Nutzer kann sie im Konto ändern)
BASE_CURRENCY=EUR
# Registrierung: offen (Standard) oder "closed" (nur bestehende Konten)
# SIGNUP=closed

# ---- Speicher ---------------------------------------------------------------
# Drei Möglichkeiten, die erste gesetzte gewinnt:
#
# 1) Redis. In Vercel unter Storage -> Create Database -> Upstash Redis dazubuchen,
#    dann setzt Vercel diese beiden Variablen selbst. Kein zweites Konto nötig.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#    (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN gehen auch)
#
# 2) Supabase. Tabelle einmal mit supabase.sql anlegen.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_TABLE=earnings_kv
#
# 3) Nichts davon gesetzt: lokale JSON-Dateien in data/ - nur für die Entwicklung.

# ---- Google OAuth-Client des Betreibers (ein Client für alle Nutzer) --------
# Cloud Console -> OAuth-Client "Webanwendung", Weiterleitungs-URI https://<domain>/api/google/callback.
# Für fremde Nutzer muss der Zustimmungsbildschirm "In production" sein und die Scopes
# admob.readonly, adsense.readonly, devstorage.read_only müssen von Google verifiziert werden.
# Jeder Nutzer kann mehrere Google-Konten verbinden (AdMob privat, Play Console über die Firma).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- RevenueCat-Login (optional, statt eines Schlüssels je Projekt) ---------
# Ohne diese Werte zeigt die App nur den Schlüssel-Weg. Der Client ist nicht
# selbst anzulegen: bei support@revenuecat.com registrieren lassen mit
#   Redirect-URI https://<domain>/api/revenuecat/callback
#   Scopes      charts_metrics:overview:read charts_metrics:charts:read
# Achtung: Refresh-Tokens laufen nach 30 Tagen ohne Nutzung ab; der tägliche
# Sammellauf hält sie am Leben.
REVENUECAT_CLIENT_ID=
REVENUECAT_CLIENT_SECRET=

# ---- Tägliche Meldung (optional) --------------------------------------------
# Ein Telegram-Bot des Betreibers; jeder Nutzer trägt seine eigene Chat-ID im Konto ein.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# ntfy braucht nichts vom Betreiber - Nutzer tragen ihr Topic im Konto ein.

# ---- Passwort vergessen per E-Mail (optional, über resend.com) --------------
RESEND_API_KEY=
MAIL_FROM=Einnahmen <noreply@einnahmen.example>

# ---- Native App: zusätzliche erlaubte Origins für CORS (kommagetrennt), optional
# APP_ORIGINS=https://zweite-domain.example

# ---- Sammellauf: Zeitbudget je Cron-Aufruf in ms (Vercel Hobby: max 60 s) ---
# COLLECT_BUDGET_MS=50000
# Konten, die jünger als das gesammelt wurden, lässt der Cron aus (Minuten-Cron neben offener App)
# COLLECT_MIN_ALTER_MS=30000

# ---- Lokal -----------------------------------------------------------------
PORT=3001

# ---- Nur für `node server/cli.js migrate`: Zugangsdaten des alten Ein-Nutzer-Betriebs
# REVENUECAT_API_KEY=  REVENUECAT_PROJECT_ID=  ADMOB_PUBLISHER_ID=  ADSENSE_ACCOUNT_ID=  PLAY_GCS_BUCKET=
# ASC_KEY_ID=  ASC_ISSUER_ID=  ASC_PRIVATE_KEY=  ASC_VENDOR_NUMBER=  WISE_API_TOKEN=  WISE_PROFILE_ID=
# PAYPAL_CLIENT_ID=  PAYPAL_CLIENT_SECRET=
