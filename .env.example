# ---- Pflicht ---------------------------------------------------------------
# Passwort fürs Dashboard (frei wählen, lang)
DASHBOARD_PASSWORD=
# Zufallsstrings, je 32+ Zeichen (z. B. `openssl rand -hex 32`)
SESSION_SECRET=
TOKEN_ENC_KEY=
CRON_SECRET=
# Öffentliche URL ohne Slash am Ende. Optional: fehlt sie, wird sie aus der Anfrage abgeleitet (auf Vercel passt das).
# PUBLIC_URL=https://earnings-dashboard.vercel.app
BASE_CURRENCY=EUR

# ---- Speicher (leer = lokale JSON-Dateien in data/) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_TABLE=earnings_kv

# ---- RevenueCat (Secret API Key v2 mit charts_metrics:overview:read) --------
# Ein Schlüssel gilt immer nur für EIN Projekt. Für weitere Projekte die Paare
# mit _2, _3 … anlegen (bis _5). LABEL ist der Anzeigename, optional.
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
# REVENUECAT_LABEL=Meine erste App
# REVENUECAT_API_KEY_2=
# REVENUECAT_PROJECT_ID_2=
# REVENUECAT_LABEL_2=Meine zweite App

# ---- Google (ein OAuth-Client für AdMob, AdSense, Play) ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AdMob-Publisher-ID, Form pub-1234567890123456
ADMOB_PUBLISHER_ID=
# AdSense-Account-ID, Form pub-1234567890123456 (nur wenn AdSense genutzt wird)
ADSENSE_ACCOUNT_ID=
# Play Console -> Berichte herunterladen -> Finanzberichte -> "Cloud Storage-URI kopieren"
# Nur den Bucket-Namen: pubsite_prod_rev_0123456789
PLAY_GCS_BUCKET=

# ---- App Store Connect (API-Key mit Rolle "Finance") ------------------------
ASC_KEY_ID=
ASC_ISSUER_ID=
# Inhalt der .p8-Datei, base64-kodiert (base64 -i AuthKey_XXXX.p8 | tr -d '\n')
ASC_PRIVATE_KEY=
ASC_VENDOR_NUMBER=

# ---- Kontostände (optional) -------------------------------------------------
WISE_API_TOKEN=
WISE_PROFILE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live oder sandbox
PAYPAL_ENV=live

# ---- Tägliche Zusammenfassung (optional) ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=

# ---- Lokal -----------------------------------------------------------------
PORT=3001
